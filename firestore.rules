rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ログイン済みかつ、自身のデータ(userId == request.auth.uid) のみアクセスを許可するヘルパー関数
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // projects コレクション
    match /projects/{projectId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId) && isOwner(request.resource.data.userId);
    }

    // tasks コレクション
    match /tasks/{taskId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId) && isOwner(request.resource.data.userId);
    }

    // side_pocket_memos コレクション
    match /side_pocket_memos/{memoId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId) && isOwner(request.resource.data.userId);
    }

    // delay_logs コレクション
    match /delay_logs/{logId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId) && isOwner(request.resource.data.userId);
    }
  }
}